{
  "name": "watzem-mobile-app",
  "version": "1.1.144",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "prebuild": "node scripts/bump-version.js",
    "build": "vue-tsc --noEmit && vite build && tsc -p server/tsconfig.json",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "bump": "node scripts/bump-version.js",
    "build:apk": "node scripts/build-apk.js",
    "build:apk:tv": "node scripts/build-tv-apk.js",
    "release:upload": "node scripts/upload-release.js",
    "start": "node dist-server/index.js",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "service:install": "node service-install.cjs",
    "service:uninstall": "node service-uninstall.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/clipboard": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/screen-orientation": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.2",
    "@hugotomazi/capacitor-navigation-bar": "^4.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-vue-next": "^0.475.0",
    "node-windows": "^1.0.0-beta.8",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/webtorrent": "^3.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
